# --- grecs-du-roi reader grecs.craven.fr (t_1bdfa688) ---
# HTTP-only vhost for grecs.craven.fr (grecs-du-roi reader + specimen).
# Served as a static tree: /srv/grecs/current -> /srv/grecs/<sha>
# Lives as soon as the OVH A record
#   grecs.craven.fr. A 91.99.62.203
# points here. Host-matched block: the pro-site catch-all and every
# sibling vhost are untouched. Flip to TLS with scripts/enable-tls.sh
# once dig +short A grecs.craven.fr equals 91.99.62.203 (same OVH
# human-step pattern as latin/englisc).
http://grecs.craven.fr {
	root * /srv/grecs/current
	encode gzip zstd
	@fonts path /fonts/*
	header @fonts Cache-Control "public, max-age=86400"
	@assets path /glyphs/*, /qa-evidence/*
	header @assets Cache-Control "public, max-age=604800"
}
# --- end grecs-du-roi reader ---

# --- grecs-du-roi reader greek.craven.fr TLS (t_1bdfa688, host t_4c9f46bf) ---
# Applied by deploy/enable-tls.sh AFTER
#   dig +short A greek.craven.fr
# equals web01's IPv4 (91.99.62.203). Until then, keep the http:// block
# from Caddyfile.http.snippet (same marked start/end pair so the flip
# replaces in place).
greek.craven.fr {
	root * /srv/grecs/current
	file_server
	encode gzip zstd
	@fonts path /fonts/*
	header @fonts Cache-Control "public, max-age=86400"
	@assets path /glyphs/*, /qa-evidence/*
	header @assets Cache-Control "public, max-age=604800"
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}
# --- end grecs-du-roi reader ---
